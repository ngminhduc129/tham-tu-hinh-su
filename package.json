{
  "name": "tham-tu-hinh-su",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thám tử Hình sự - trò chơi học tập điều tra và phân tích pháp lý (MVP client-side)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run lint:content",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus": "vitest run src/domain/schema-2.1.0.test.ts src/domain/semantic.test.ts src/content/content.test.ts",
    "lint:content": "tsx scripts/lint-content.ts",
    "check": "npm run lint:content && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
