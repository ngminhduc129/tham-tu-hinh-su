{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tham-tu-hinh-su.invalid/schema/case-2.1.0.json",
  "title": "Thám tử Hình sự — case content",
  "$comment": "2.1.0 là bản mở rộng tương thích ngược của 2.0.0: trường mới đều optional; vocabulary cũ được giữ nguyên.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "brief",
    "temporal_context",
    "characters",
    "facts",
    "evidence",
    "procedural_defects",
    "evidence_limitations",
    "hypotheses",
    "law_bundles",
    "proof_matrix",
    "candidate_charges",
    "charge_elements",
    "charge_comparisons",
    "age_rules",
    "circumstances",
    "conclusions",
    "answer_fields",
    "expected_responses",
    "answer_paths",
    "consistency_rules",
    "criteria",
    "scoring",
    "review",
    "explanations",
    "references"
  ],
  "properties": {
    "schema_version": { "enum": ["2.0.0", "2.1.0"] },
    "metadata": { "$ref": "#/$defs/metadata" },
    "brief": {
      "type": "object",
      "required": ["narrative", "task_prompt", "player_role"],
      "properties": {
        "narrative": { "type": "string" },
        "task_prompt": { "type": "string" },
        "player_role": { "type": "string" }
      },
      "additionalProperties": false
    },
    "characters": { "type": "array", "items": { "$ref": "#/$defs/character" } },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "procedural_defects": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "evidence_limitations": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "hypotheses": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "law_bundles": { "type": "array", "items": { "$ref": "#/$defs/law_bundle" } },
    "charge_comparisons": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "conclusions": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "explanations": { "type": "array", "items": { "$ref": "#/$defs/content_record" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "critical_issue_ids": { "$ref": "#/$defs/ids" },
    "hints": { "type": "array", "items": { "$ref": "#/$defs/hint" } },
    "glossary": { "type": "array", "items": { "$ref": "#/$defs/glossary_entry" } },
    "references": {
      "type": "object",
      "required": ["legal_basis_ids"],
      "properties": { "legal_basis_ids": { "$ref": "#/$defs/ids" } },
      "additionalProperties": false
    },
    "temporal_context": {
      "type": "object",
      "required": ["conduct_events"],
      "properties": {
        "conduct_events": { "type": "array", "items": { "$ref": "#/$defs/conduct_event" } }
      },
      "additionalProperties": false
    },
    "answer_fields": { "type": "array", "items": { "$ref": "#/$defs/answer_field" } },
    "expected_responses": { "type": "array", "items": { "$ref": "#/$defs/expected_response" } },
    "answer_paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/answer_path" } },
    "consistency_rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "scoring": { "$ref": "#/$defs/scoring" },
    "path_selection": { "$ref": "#/$defs/path_selection" },
    "candidate_charges": { "type": "array", "items": { "$ref": "#/$defs/charge" } },
    "charge_elements": { "type": "array", "items": { "$ref": "#/$defs/charge_element" } },
    "circumstances": { "type": "array", "items": { "$ref": "#/$defs/circumstance" } },
    "age_rules": { "type": "array", "items": { "$ref": "#/$defs/age_rule" } },
    "proof_matrix": { "type": "array", "items": { "$ref": "#/$defs/proof_row" } },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "description": { "type": "string" },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "review_ids"],
      "properties": {
        "status": { "enum": ["not_reviewed", "in_review", "approved", "review_required"] },
        "review_ids": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]{1,99}$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "content_record": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/id" } },
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "evidence_ids": { "$ref": "#/$defs/ids" },
        "answer_field_ids": { "$ref": "#/$defs/ids" },
        "critical": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "hint": {
      "type": "object",
      "required": ["id", "level", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "text": { "type": "string" },
        "order": { "type": "integer", "minimum": 0 },
        "issue_id": { "type": ["string", "null"] },
        "rubric_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "glossary_entry": {
      "type": "object",
      "required": ["id", "term", "definition"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "term": { "type": "string" },
        "definition": { "type": "string" },
        "legal_basis_ids": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": ["id", "display_name", "roles", "birth_date_interval"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string" },
        "roles": { "type": "array", "items": { "type": "string" } },
        "birth_date_interval": { "$ref": "#/$defs/date_interval" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "law_bundle": {
      "type": "object",
      "required": ["id", "version", "jurisdiction", "provisions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "provisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "citation", "effective_from", "effective_to", "source_ref", "review_status"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "citation": { "type": "string" },
              "effective_from": { "type": ["string", "null"], "format": "date" },
              "effective_to": { "type": ["string", "null"], "format": "date" },
              "source_ref": { "type": "string" },
              "review_status": { "enum": ["not_reviewed", "in_review", "approved", "review_required"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "status",
        "jurisdiction",
        "law_bundle_ids",
        "learning_outcome_ids",
        "legal_time_anchor",
        "legal_time_anchor_reason"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string" },
        "title": { "type": "string" },
        "status": {
          "enum": ["draft", "review", "approved", "published", "review_required", "retired"]
        },
        "jurisdiction": { "type": "string" },
        "law_bundle_ids": { "$ref": "#/$defs/ids" },
        "learning_outcome_ids": { "$ref": "#/$defs/ids" },
        "legal_time_anchor": { "enum": ["conduct_date", "case_defined", "reviewer_defined"] },
        "legal_time_anchor_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "law_segment": {
      "type": "object",
      "required": ["start_date", "end_date", "bundle_id"],
      "properties": {
        "start_date": { "type": ["string", "null"], "format": "date" },
        "end_date": { "type": ["string", "null"], "format": "date" },
        "bundle_id": { "$ref": "#/$defs/id" },
        "provision_ids": { "$ref": "#/$defs/ids" },
        "review_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "path_selection": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["priority", "exclusive"] },
        "order": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": false
    },
    "evidence_link": {
      "type": "object",
      "required": ["evidence_id", "relation"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/id" },
        "relation": {
          "description": "supports = ủng hộ; challenges/contradicts = phản bác; context/contextual = bối cảnh. Đây là quan hệ logic, không phải kết luận chứng minh.",
          "enum": ["supports", "challenges", "contradicts", "context", "contextual"]
        },
        "limitation_ids": { "$ref": "#/$defs/ids" },
        "strength": { "enum": ["strong", "partial", "weak"] },
        "weight": { "type": "number", "minimum": 0 },
        "reasoning": { "type": "string" }
      },
      "additionalProperties": false
    },
    "date_interval": {
      "type": "object",
      "required": ["start_date", "end_date", "precision", "source_ids"],
      "properties": {
        "start_date": { "type": ["string", "null"], "format": "date" },
        "end_date": { "type": ["string", "null"], "format": "date" },
        "precision": { "enum": ["day", "month", "year", "range", "unknown"] },
        "source_ids": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": false
    },
    "conduct_event": {
      "type": "object",
      "required": ["id", "date_interval", "law_resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date_interval": { "$ref": "#/$defs/date_interval" },
        "law_resolution": {
          "type": "object",
          "required": ["status", "bundle_id", "review_id"],
          "properties": {
            "status": { "enum": ["resolved", "crosses_version", "unresolved"] },
            "bundle_id": { "type": ["string", "null"] },
            "review_id": { "type": ["string", "null"] },
            "segments": {
              "type": "array",
              "items": { "$ref": "#/$defs/law_segment" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "answer_field": {
      "type": "object",
      "required": ["id", "scope", "target_ids", "value_type", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": {
          "enum": [
            "case",
            "evidence",
            "hypothesis",
            "proof_row",
            "charge_element",
            "person_conduct",
            "circumstance",
            "conclusion"
          ]
        },
        "target_ids": { "$ref": "#/$defs/ids" },
        "value_type": { "enum": ["single_choice", "multi_select"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "expected_response": {
      "type": "object",
      "required": [
        "id",
        "path_ids",
        "field_id",
        "target_id",
        "accepted_values",
        "weight",
        "criterion_id",
        "learning_outcome_ids",
        "explanation_id"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path_ids": { "$ref": "#/$defs/ids" },
        "field_id": { "$ref": "#/$defs/id" },
        "target_id": { "$ref": "#/$defs/id" },
        "accepted_values": { "$ref": "#/$defs/ids" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "criterion_id": { "$ref": "#/$defs/id" },
        "learning_outcome_ids": { "$ref": "#/$defs/ids" },
        "explanation_id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": { "enum": ["all", "any"] },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expr" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "field_id", "target_id", "value"],
          "properties": {
            "op": { "enum": ["equals", "not_equals", "contains", "not_contains"] },
            "field_id": { "$ref": "#/$defs/id" },
            "target_id": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "field_id", "target_id"],
          "properties": {
            "op": { "enum": ["is_empty", "is_not_empty"] },
            "field_id": { "$ref": "#/$defs/id" },
            "target_id": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        }
      ]
    },
    "answer_path": {
      "type": "object",
      "required": ["id", "match", "conclusion_ids", "charge_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "match": { "$ref": "#/$defs/expr" },
        "conclusion_ids": { "$ref": "#/$defs/ids" },
        "charge_ids": { "$ref": "#/$defs/ids" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "mode": { "enum": ["exclusive", "priority", "multi_match"] },
        "priority": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["id", "scope", "when", "assert", "severity", "message"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "scope": {
          "type": "object",
          "required": ["person_id", "conduct_event_id"],
          "properties": {
            "person_id": { "$ref": "#/$defs/id" },
            "conduct_event_id": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        "when": { "$ref": "#/$defs/expr" },
        "assert": { "$ref": "#/$defs/expr" },
        "severity": { "enum": ["blocking", "major", "minor"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "learning_outcome_ids", "answer_field_ids", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "learning_outcome_ids": { "$ref": "#/$defs/ids" },
        "answer_field_ids": { "$ref": "#/$defs/ids" },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": ["path_weights", "partial_credit"],
      "properties": {
        "max_total_points": { "const": 100 },
        "path_weights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path_id", "criterion_points"],
            "properties": {
              "path_id": { "$ref": "#/$defs/id" },
              "criterion_points": {
                "type": "object",
                "additionalProperties": { "type": "number", "minimum": 0 }
              }
            },
            "additionalProperties": false
          }
        },
        "partial_credit": {
          "type": "object",
          "required": ["method", "rounding"],
          "properties": {
            "method": { "const": "weighted_expectation_ratio" },
            "rounding": { "const": "nearest_integer" },
            "weight_scope": { "const": "within_criterion" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "charge": {
      "type": "object",
      "required": ["id", "person_id", "conduct_event_ids", "legal_basis_ids", "charge_element_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_label": { "type": "string" },
        "person_id": { "$ref": "#/$defs/id" },
        "conduct_event_ids": { "$ref": "#/$defs/ids" },
        "legal_basis_ids": { "$ref": "#/$defs/ids" },
        "charge_element_ids": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": true
    },
    "charge_element": {
      "type": "object",
      "required": ["id", "charge_id", "element_type", "required", "legal_basis_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "charge_id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "legal_test": { "type": "string" },
        "element_type": {
          "enum": [
            "protected_interest",
            "conduct",
            "result",
            "causation",
            "subject",
            "mental_state",
            "circumstance",
            "other"
          ]
        },
        "required": { "type": "boolean" },
        "fact_ids": { "$ref": "#/$defs/ids" },
        "evidence_ids": { "$ref": "#/$defs/ids" },
        "legal_basis_ids": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": true
    },
    "circumstance": {
      "type": "object",
      "required": [
        "id",
        "category",
        "person_id",
        "conduct_event_ids",
        "legal_basis_ids",
        "review_status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "category": { "enum": ["aggravating", "mitigating", "other"] },
        "person_id": { "$ref": "#/$defs/id" },
        "conduct_event_ids": { "$ref": "#/$defs/ids" },
        "legal_basis_ids": { "$ref": "#/$defs/ids" },
        "fact_ids": { "$ref": "#/$defs/ids" },
        "review_status": { "enum": ["not_reviewed", "in_review", "approved"] }
      },
      "additionalProperties": true
    },
    "age_rule": {
      "type": "object",
      "required": [
        "id",
        "candidate_charge_ids",
        "conduct_event_ids",
        "law_bundle_ids",
        "legal_basis_ids",
        "conditions",
        "review_status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "candidate_charge_ids": { "$ref": "#/$defs/ids" },
        "conduct_event_ids": { "$ref": "#/$defs/ids" },
        "law_bundle_ids": { "$ref": "#/$defs/ids" },
        "legal_basis_ids": { "$ref": "#/$defs/ids" },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "min_age_years",
              "max_age_years",
              "applies_to_charge_ids",
              "effect_code",
              "legal_basis_ids",
              "review_id"
            ],
            "properties": {
              "min_age_years": { "type": "integer", "minimum": 0 },
              "max_age_years": { "type": "integer", "minimum": 0 },
              "applies_to_charge_ids": { "$ref": "#/$defs/ids" },
              "effect_code": { "type": "string" },
              "legal_basis_ids": { "$ref": "#/$defs/ids" },
              "review_id": { "$ref": "#/$defs/id" }
            },
            "additionalProperties": false
          }
        },
        "review_status": { "enum": ["not_reviewed", "in_review", "approved"] }
      },
      "additionalProperties": false
    },
    "proof_row": {
      "type": "object",
      "required": ["id", "proposition", "charge_element_ids", "evidence_links"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "proposition": { "type": "string" },
        "charge_element_ids": { "$ref": "#/$defs/ids" },
        "evidence_links": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_link" }
        },
        "status": {
          "enum": ["established", "partially_established", "not_established", "disputed"]
        }
      },
      "additionalProperties": false
    }
  }
}
